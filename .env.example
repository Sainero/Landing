# Адрес облачной версии (отдельное приложение). Пока не задан, кнопки «Облако»
# ведут на раздел #cloud лендинга с пометкой «скоро».
# Пример: https://app.slideria.ru
PUBLIC_CLOUD_URL=

# Ссылка на установщик программы для Windows. Пока не задана, кнопка
# «Программа для Windows» ведёт на её описание в документации.
PUBLIC_DOWNLOAD_URL=

# Публичный адрес лендинга: sitemap, canonical, Open Graph
SITE_URL=https://slideria.example
