---
import { siteConfig } from '@/shared/lib/config';
import { footerColumns } from '@/shared/lib/data/mainData';
import Container from '@/shared/ui-kit/Container.astro';
import Logo from '@/shared/ui-kit/Logo.astro';
---
<footer class="relative border-t border-bd bg-alt/60">
  <Container class="grid gap-10 py-14 md:grid-cols-[1.4fr_1fr_1fr_1fr]">
    <div class="flex flex-col gap-4">
      <Logo />
      <p class="max-w-xs text-sm leading-relaxed text-mu">Слайды как данные, правка как в PowerPoint, показ как кино. Один HTML-файл, PowerPoint или PDF.</p>
    </div>
    {footerColumns.map((col) => (
      <div>
        <h2 class="mb-3 text-xs font-bold uppercase tracking-[.14em] text-mu">{col.title}</h2>
        <ul class="flex flex-col gap-2">
          {col.links.map((l) => <li><a href={l.href} class="text-[15px] text-tx2 transition hover:text-ac">{l.label}</a></li>)}
        </ul>
      </div>
    ))}
    <div>
      <h2 class="mb-3 text-xs font-bold uppercase tracking-[.14em] text-mu">Облако</h2>
      <p class="text-[15px] leading-relaxed text-tx2">Та же студия в браузере — отдельным приложением, без установки.</p>
      <a href="/#cloud" class="mt-2 inline-block text-[15px] font-semibold text-ac hover:underline">Что будет в облаке →</a>
    </div>
  </Container>
  <Container class="flex flex-wrap items-center justify-between gap-3 border-t border-bd py-5 text-[13px] text-mu">
    <span>© 2026 Slideria</span>
    <span>Slideria {siteConfig.engine.version}</span>
  </Container>
</footer>
