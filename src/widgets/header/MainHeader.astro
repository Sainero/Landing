---
import { BookOpen, Menu, X } from '@lucide/astro';
import DownloadLink from '@/entities/app/DownloadLink.astro';
import CloudLink from '@/entities/cloud/CloudLink.astro';
import { mainNavLinks } from '@/shared/lib/data/mainData';
import Logo from '@/shared/ui-kit/Logo.astro';
import ThemeToggle from '@/shared/ui-kit/ThemeToggle.astro';

const path = Astro.url.pathname;
const active = (href: string) => (href === '/docs' ? path.startsWith('/docs') : false);
---
<header
  data-header
  class="group/h fixed inset-x-0 top-0 z-50 border-b border-transparent transition-[background,border-color,backdrop-filter] duration-300 data-[scrolled]:border-bd data-[scrolled]:bg-[var(--glass)]"
>
  <div class="mx-auto flex h-16 max-w-[1200px] items-center gap-6 px-4 sm:px-6">
    <a href="/" class="shrink-0 rounded-xl" aria-label="Slideria — на главную"><Logo /></a>

    <nav class="hidden flex-1 items-center gap-1 lg:flex" aria-label="Основная навигация">
      {mainNavLinks.map((l) => (
        <a
          href={l.href}
          class:list={['rounded-lg px-3 py-2 text-[14.5px] font-semibold transition hover:bg-alt hover:text-tx', active(l.href) ? 'text-tx' : 'text-tx2']}
        >{l.label}</a>
      ))}
    </nav>

    <div class="ml-auto flex items-center gap-2">
      <ThemeToggle />
      <CloudLink size="sm" class="max-sm:hidden" label="Облако" />
      <button type="button" data-menu-open class="grid size-9 place-items-center rounded-full border border-bd bg-surf lg:hidden" aria-label="Открыть меню">
        <Menu class="size-[18px]" />
      </button>
    </div>
  </div>
</header>

<dialog
  data-mobile-menu
  class="m-0 ml-auto h-dvh max-h-none w-[min(360px,88vw)] max-w-none border-l border-bd bg-surf p-0 text-tx backdrop:bg-black/40 backdrop:backdrop-blur-sm"
  aria-label="Меню"
>
  <div class="flex h-full flex-col p-5">
    <div class="flex items-center justify-between">
      <Logo />
      <button type="button" data-menu-close class="grid size-9 place-items-center rounded-full border border-bd" aria-label="Закрыть меню"><X class="size-[18px]" /></button>
    </div>
    <nav class="mt-8 flex flex-col gap-1" aria-label="Мобильная навигация">
      {mainNavLinks.map((l) => <a href={l.href} class="rounded-xl px-3 py-3 text-lg font-semibold text-tx hover:bg-alt">{l.label}</a>)}
    </nav>
    <div class="mt-auto flex flex-col gap-3">
      <CloudLink size="lg" />
      <DownloadLink size="lg" />
      <a href="/docs" class="inline-flex h-12 items-center justify-center gap-2 rounded-xl border border-bd2 font-semibold"><BookOpen class="size-4" />Документация</a>
    </div>
  </div>
</dialog>
