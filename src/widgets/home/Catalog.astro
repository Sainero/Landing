---
import {
  ChartColumn, ChartNoAxesGantt, ChartSpline, Image, ImagePlus, LayoutGrid, LayoutPanelTop, List, ListTree, Loader,
  Network, Orbit, PanelsTopLeft, RectangleHorizontal, Rocket, Rows3, Share2, SlidersHorizontal, Space, Sparkles,
  SquareStack, StickyNote, Tags, Type, Workflow,
} from '@lucide/astro';
import { catalog, componentGroups } from '@/shared/lib/data/components';
import Container from '@/shared/ui-kit/Container.astro';
import SectionHeading from '@/shared/ui-kit/SectionHeading.astro';

const icons: Record<string, typeof Share2> = {
  ChartColumn, ChartNoAxesGantt, ChartSpline, Image, ImagePlus, LayoutGrid, LayoutPanelTop, List, ListTree, Loader,
  Network, Orbit, PanelsTopLeft, RectangleHorizontal, Rocket, Rows3, Share2, SlidersHorizontal, Space, Sparkles,
  SquareStack, StickyNote, Tags, Type, Workflow,
};
const groups = [{ id: 'all', label: 'Все' }, ...componentGroups];
const count = (id: string) => (id === 'all' ? catalog.length : catalog.filter((c) => c.group === id).length);
---
<section id="components" class="relative py-24 sm:py-32">
  <Container>
    <SectionHeading
      eyebrow="Компоненты"
      title={`${catalog.length} кирпичиков для слайдов`}
      lead="Каждый подключается одной строкой type в deck.yaml. Цвета берутся из темы, анимации запускаются при открытии слайда."
    />

    <div data-catalog class="mt-12">
      <div role="tablist" aria-label="Группы компонентов" class="mx-auto flex w-fit max-w-full gap-1 overflow-x-auto rounded-2xl border border-bd bg-surf p-1 shadow-[var(--shadow-sm)] [scrollbar-width:none]">
        {groups.map((g, i) => (
          <button
            type="button"
            role="tab"
            data-filter={g.id}
            aria-selected={i === 0 ? 'true' : 'false'}
            class="whitespace-nowrap rounded-xl px-4 py-2 text-[14px] font-semibold text-tx2 transition hover:text-tx aria-selected:bg-ac aria-selected:text-white"
          >{g.label} <span class="ml-1 font-mono text-[11px] opacity-60">{count(g.id)}</span></button>
        ))}
      </div>

      <ul class="mt-8 grid grid-cols-[minmax(0,1fr)] gap-3 sm:grid-cols-2 lg:grid-cols-4 xl:grid-cols-5">
        {catalog.map((c) => {
          const Icon = icons[c.icon] ?? Share2;
          return (
            <li data-group={c.group} class="data-[hidden]:hidden">
              <a
                href={`/docs/components#${c.type}`}
                class="group/c flex h-full flex-col rounded-2xl border border-bd bg-surf p-4 transition duration-300 hover:-translate-y-0.5 hover:border-acb hover:shadow-[var(--shadow-md)]"
              >
                <span class="flex items-center justify-between">
                  <span class="grid size-9 place-items-center rounded-xl bg-acs text-ac transition group-hover/c:bg-ac group-hover/c:text-white"><Icon class="size-[18px]" /></span>
                  <code class="rounded-md border border-bd bg-alt px-1.5 py-0.5 font-mono text-[11.5px] text-tx2">{c.group === 'templates' ? 'template' : 'type'}: {c.type}</code>
                </span>
                <b class="mt-3 text-[15px] text-tx">{c.title}</b>
                <span class="mt-1 text-[13.5px] leading-snug text-mu">{c.text}</span>
              </a>
            </li>
          );
        })}
      </ul>
      <p class="mt-8 text-center text-[14.5px] text-mu">
        Не хватает своего? <a href="/docs/custom-components" class="font-semibold text-ac hover:underline">Компонент пишется за 20 строк TypeScript →</a>
      </p>
    </div>
  </Container>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-catalog]').forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-filter]')];
    const items = [...root.querySelectorAll<HTMLElement>('[data-group]')];
    tabs.forEach((t) => t.addEventListener('click', () => {
      const f = t.dataset.filter;
      tabs.forEach((x) => x.setAttribute('aria-selected', String(x === t)));
      items.forEach((it) => it.toggleAttribute('data-hidden', f !== 'all' && it.dataset.group !== f));
    }));
  });
</script>
