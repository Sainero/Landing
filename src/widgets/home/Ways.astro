---
/**
 * «Три способа сделать презентацию». Карточки одного устройства: сверху — картинка способа
 * (настоящие кадры витрины), снизу — заголовок, одна фраза и три пункта. Поэтому высота у них
 * одинаковая и внутри нет пустот.
 */
import { ArrowRight, Bot, Check, FileUp, Sparkles } from '@lucide/astro';
import SlideThumb from '@/entities/deck/ui/SlideThumb.astro';
import Container from '@/shared/ui-kit/Container.astro';
import SectionHeading from '@/shared/ui-kit/SectionHeading.astro';

const path = [
  { title: 'Идея', sub: 'с нуля или импорт' },
  { title: 'Студия', sub: 'правка как в PowerPoint' },
  { title: 'Анимация', sub: 'появления и переходы' },
  { title: 'Показ', sub: 'окно докладчика, пульт' },
  { title: 'Экспорт', sub: 'HTML · PPTX · PDF' },
];

const ways = [
  {
    id: 'pptx',
    title: 'Из PowerPoint',
    icon: FileUp,
    iconClass: 'bg-[linear-gradient(135deg,#F97316,#EA580C)] shadow-[0_10px_24px_-8px_#EA580C]',
    lead: 'Перетащите .pptx в студию: каждый слайд станет холстом, объекты встанут на свои места и будут правиться.',
    points: ['Тексты, шрифты и списки — текстом', 'Таблицы и диаграммы — с данными', 'Фон, заметки и переходы — как в файле'],
  },
  {
    id: 'html',
    title: 'Из Claude Design и HTML',
    icon: Sparkles,
    iconClass: 'bg-[linear-gradient(135deg,var(--vi),var(--pk))] shadow-[0_10px_24px_-8px_var(--pk)]',
    lead: 'Макет из Claude Design, презентация из чата с ИИ или свой HTML — импорт заберёт слайды из файла.',
    points: ['Редактируемые: правка на месте', 'Живые: 1:1, скрипты работают', 'Цвета подстраиваются под тему'],
  },
  {
    id: 'agent',
    title: 'Попросите агента',
    icon: Bot,
    iconClass: 'bg-[linear-gradient(135deg,var(--ac),var(--cy))] shadow-[0_10px_24px_-8px_var(--cy)]',
    lead: 'Опишите задачу словами — агент соберёт слайды родными блоками: схемы, графики, таблицы, а не картинки.',
    points: ['Чат в студии с моделью на выбор', 'Или ваш агент по MCP', 'Сам проверяет слайд картинкой'],
  },
];
const visual = 'relative h-[232px] overflow-hidden border-b border-bd bg-[radial-gradient(120%_90%_at_50%_0%,var(--acs),transparent_70%)]';
---
<section id="how" data-anim class="relative py-24 sm:py-32">
  <Container>
    <SectionHeading eyebrow="С чего начать" lead="Принесите готовую презентацию, соберите её в студии или поручите агенту. Дальше всё одинаково: правка, показ, экспорт.">
      <Fragment slot="title">Три способа сделать презентацию</Fragment>
    </SectionHeading>

    <div class="mt-16 grid grid-cols-[minmax(0,1fr)] gap-5 lg:grid-cols-3">
      {ways.map((w, i) => (
        <article data-reveal data-way={w.id} class="flex flex-col overflow-hidden rounded-3xl border border-bd bg-surf shadow-[var(--shadow-sm)]" style={`--d:${(i * 0.1).toFixed(1)}s`}>
          {w.id === 'pptx' && (
            <div class={visual} aria-hidden="true">
              <!-- файл PowerPoint → слайды-холсты -->
              <div class="absolute left-5 top-1/2 w-[84px] -translate-y-1/2">
                <div class="overflow-hidden rounded-xl border border-bd bg-surf shadow-[var(--shadow-md)]">
                  <div class="grid h-7 place-items-center bg-[linear-gradient(135deg,#F97316,#D24726)] text-[11px] font-bold tracking-wide text-white">PPTX</div>
                  <div class="flex flex-col gap-1.5 p-2.5">
                    <i class="h-1.5 w-4/5 rounded-full bg-bd2"></i>
                    <i class="h-1.5 w-full rounded-full bg-bd"></i>
                    <i class="h-1.5 w-3/5 rounded-full bg-bd"></i>
                    <i class="mt-1 h-6 w-full rounded-md bg-[linear-gradient(90deg,#FDBA74,#F97316)] opacity-70"></i>
                  </div>
                </div>
                <div class="mt-2 truncate text-center font-mono text-[10.5px] text-mu">отчёт-q3.pptx</div>
              </div>
              <span class="absolute left-[112px] top-1/2 grid size-7 -translate-y-1/2 place-items-center rounded-full border border-bd bg-surf text-ac shadow-[var(--shadow-sm)]"><ArrowRight class="size-3.5" /></span>
              <div class="absolute right-5 top-1/2 w-[calc(100%-168px)] -translate-y-1/2">
                <div class="relative">
                  <div class="absolute inset-0 -translate-y-3 translate-x-3 scale-[.94] opacity-50"><SlideThumb slide={6} /></div>
                  <div class="relative"><SlideThumb slide={5} class="shadow-[var(--shadow-md)]" /></div>
                </div>
                <div class="mt-3 flex items-center justify-center gap-1.5 text-[11.5px] font-semibold text-tx2">
                  <span class="size-1.5 rounded-full bg-ok"></span>каждый слайд — холст
                </div>
              </div>
            </div>
          )}

          {w.id === 'html' && (
            <div class={visual} aria-hidden="true">
              <!-- HTML-файл → редактируемые или живые слайды -->
              <div class="flex h-full flex-col px-5 pt-5">
                <span class="mx-auto inline-flex items-center gap-2 rounded-lg border border-bd bg-surf px-2.5 py-1.5 text-[12px] font-semibold text-tx shadow-[var(--shadow-sm)]">
                  <span class="rounded bg-[linear-gradient(135deg,var(--vi),var(--pk))] px-1.5 py-0.5 text-[10px] font-bold text-white">HTML</span>макет из Claude Design
                </span>
                <svg viewBox="0 0 200 22" preserveAspectRatio="none" class="mx-auto h-[22px] w-1/2 text-bd2"><path d="M100 0 C100 14, 40 8, 40 22 M100 0 C100 14, 160 8, 160 22" fill="none" stroke="currentColor" stroke-width="1.5" vector-effect="non-scaling-stroke" /></svg>
                <div class="grid grid-cols-2 gap-3">
                  <figure>
                    <div class="relative">
                      <SlideThumb slide={4} />
                      <!-- рамка выделения: текст правится на месте -->
                      <span class="absolute left-[4%] top-[5%] h-[25%] w-[40%] rounded-[3px] border-[1.5px] border-ac">
                        <i class="absolute -left-[3px] -top-[3px] size-[5px] rounded-[1px] bg-ac"></i><i class="absolute -right-[3px] -top-[3px] size-[5px] rounded-[1px] bg-ac"></i>
                        <i class="absolute -bottom-[3px] -left-[3px] size-[5px] rounded-[1px] bg-ac"></i><i class="absolute -bottom-[3px] -right-[3px] size-[5px] rounded-[1px] bg-ac"></i>
                      </span>
                    </div>
                    <figcaption class="mt-2 text-center text-[12px] font-semibold text-tx">Редактируемые</figcaption>
                  </figure>
                  <figure>
                    <div class="relative">
                      <SlideThumb slide={13} />
                      <span class="absolute right-1.5 top-1.5 inline-flex items-center gap-1 rounded-full bg-[rgba(0,0,0,.55)] px-1.5 py-0.5 text-[9.5px] font-bold uppercase tracking-wide text-white">
                        <span class="live-dot size-1.5 rounded-full bg-[#F43F5E]"></span>live
                      </span>
                    </div>
                    <figcaption class="mt-2 text-center text-[12px] font-semibold text-tx">Живые</figcaption>
                  </figure>
                </div>
              </div>
            </div>
          )}

          {w.id === 'agent' && (
            <div class={visual} aria-hidden="true">
              <!-- просьба → готовые слайды -->
              <div class="flex h-full flex-col justify-center gap-2.5 px-5">
                <div class="ml-auto max-w-[86%] rounded-2xl rounded-br-md bg-ac px-3.5 py-2 text-[12.5px] leading-snug text-white shadow-[0_8px_20px_-10px_var(--ac)]">Сделай 10 слайдов по итогам квартала: выручка, клиенты, планы</div>
                <div class="max-w-[94%] rounded-2xl rounded-bl-md border border-bd bg-surf p-2.5 shadow-[var(--shadow-sm)]">
                  <div class="flex items-center gap-1.5 px-1 text-[12px] font-semibold text-tx2">
                    <Bot class="size-3.5 text-ac" />Готово: 10 слайдов, каждый проверил
                  </div>
                  <div class="mt-2 grid grid-cols-3 gap-1.5">
                    <SlideThumb slide={1} class="rounded-md" />
                    <SlideThumb slide={5} class="rounded-md" />
                    <SlideThumb slide={6} class="rounded-md" />
                  </div>
                </div>
              </div>
            </div>
          )}

          <div class="flex flex-1 flex-col p-6">
            <div class="flex items-center gap-3">
              <span class:list={['grid size-10 shrink-0 place-items-center rounded-xl text-white', w.iconClass]}><w.icon class="size-5" /></span>
              <h3 class="text-xl font-bold text-tx">{w.title}</h3>
            </div>
            <p class="mt-3 text-[15px] leading-relaxed text-mu">{w.lead}</p>
            <ul class="mt-4 flex flex-col gap-2 text-[14px] leading-snug text-tx2">
              {w.points.map((p) => (
                <li class="flex gap-2.5"><span class="mt-px grid size-[18px] shrink-0 place-items-center rounded-full bg-acs text-ac"><Check class="size-3" stroke-width={3} /></span>{p}</li>
              ))}
            </ul>
          </div>
        </article>
      ))}
    </div>

    <!-- путь презентации, как на втором слайде витрины -->
    <ol data-reveal class="relative mx-auto mt-16 grid max-w-4xl grid-cols-5 gap-2">
      <div aria-hidden="true" class="absolute left-[10%] right-[10%] top-[15px] h-px bg-gradient-to-r from-ac via-vi to-pk opacity-50">
        <span class="pulse-x"><i class="absolute -left-[3px] -top-[3px] size-[7px] rounded-full bg-ac shadow-[0_0_12px_var(--ac)]"></i></span>
        <span class="pulse-x" style="--d:1.2s"><i class="absolute -left-[3px] -top-[3px] size-[7px] rounded-full bg-pk shadow-[0_0_12px_var(--pk)]"></i></span>
      </div>
      {path.map((p, i) => (
        <li class="relative flex flex-col items-center text-center">
          <span class="relative z-10 grid size-8 place-items-center rounded-full border-2 border-ac bg-surf font-mono text-[12px] font-bold text-ac">{i + 1}</span>
          <b class="mt-2 text-[14px] text-tx">{p.title}</b>
          <span class="text-[12px] leading-snug text-mu">{p.sub}</span>
        </li>
      ))}
    </ol>
  </Container>
</section>

<style>
  /* «live» на живом слайде мигает (только opacity) */
  .live-dot { animation: live-dot 1.6s ease-in-out infinite; }
  @keyframes live-dot { 50% { opacity: .25; } }
</style>
