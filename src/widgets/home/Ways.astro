---
import { FileCode, FileUp, Sparkles } from '@lucide/astro';
import CodeBlock from '@/shared/ui-kit/CodeBlock.astro';
import Container from '@/shared/ui-kit/Container.astro';
import SectionHeading from '@/shared/ui-kit/SectionHeading.astro';

const slide = `- title: Итоги квартала
  badge: Q3
  body:
    - type: stat
      value: 3,4 млн
      label: выручка за квартал
      delta: +18 %
    - type: bars
      values: [3, 5, 4, 7]
      labels: [Июл, Авг, Сен, Окт]`;

const path = [
  { title: 'Идея', sub: 'с нуля или импорт' },
  { title: 'Студия', sub: 'правка как в PowerPoint' },
  { title: 'Анимация', sub: 'появления и переходы' },
  { title: 'Показ', sub: 'окно докладчика, пульт' },
  { title: 'Экспорт', sub: 'HTML · PPTX · PDF' },
];
const card = 'relative flex flex-col rounded-3xl border border-bd bg-surf p-6 shadow-[var(--shadow-sm)]';
---
<section id="how" class="relative py-24 sm:py-32">
  <Container>
    <SectionHeading eyebrow="С чего начать" lead="Принесите готовую презентацию, соберите в студии или попросите Claude написать deck.yaml. Дальше всё одинаково: правка, показ, экспорт.">
      <Fragment slot="title">Три способа сделать презентацию</Fragment>
    </SectionHeading>

    <div class="mt-16 grid grid-cols-[minmax(0,1fr)] gap-5 lg:grid-cols-3">
      <article data-reveal class={card}>
        <span class="grid size-12 place-items-center rounded-2xl bg-[linear-gradient(135deg,#F97316,#EA580C)] text-white shadow-[0_10px_30px_-8px_#EA580C]"><FileUp class="size-6" /></span>
        <h3 class="mt-5 text-xl font-bold text-tx">Из PowerPoint</h3>
        <p class="mt-2 text-[15px] leading-relaxed text-mu">Перетащите .pptx на страницу: каждый слайд — холст, объекты на своих местах. Надписи остаются текстом, таблицы — таблицами, заметки — заметками.</p>
        <div class="mt-auto pt-6">
          <div class="rounded-2xl border-2 border-dashed border-bd2 bg-alt/60 p-4 text-center">
            <span class="inline-flex items-center gap-2 rounded-lg border border-bd bg-surf px-3 py-2 font-mono text-[12.5px] text-tx shadow-[var(--shadow-sm)]">
              <span class="rounded bg-[#D24726] px-1.5 py-0.5 text-[10px] font-bold text-white">PPTX</span>отчёт-q3.pptx
            </span>
            <div class="mt-3 text-[12.5px] text-mu">187 стандартных фигур · таблицы · фон · заметки</div>
          </div>
        </div>
      </article>

      <article data-reveal class={card} style="--d:.1s">
        <span class="grid size-12 place-items-center rounded-2xl bg-[linear-gradient(135deg,var(--vi),var(--pk))] text-white shadow-[0_10px_30px_-8px_var(--pk)]"><Sparkles class="size-6" /></span>
        <h3 class="mt-5 text-xl font-bold text-tx">Из Claude Design и HTML</h3>
        <p class="mt-2 text-[15px] leading-relaxed text-mu">Каркас нарисовали мышью или Claude сверстал в чате — импорт превратит слайды в редактируемые или оставит живыми, со скриптами как есть.</p>
        <div class="mt-auto grid grid-cols-2 gap-2 pt-6 text-[12.5px]">
          <div class="rounded-xl border border-bd bg-alt/60 p-3"><b class="block text-tx">Редактируемые</b><span class="text-mu">почти 1:1, тексты правятся на месте</span></div>
          <div class="rounded-xl border border-bd bg-alt/60 p-3"><b class="block text-tx">Живые</b><span class="text-mu">1:1, скрипты файла работают</span></div>
        </div>
      </article>

      <article data-reveal class={card} style="--d:.2s">
        <span class="grid size-12 place-items-center rounded-2xl bg-[linear-gradient(135deg,var(--ac),var(--cy))] text-white shadow-[0_10px_30px_-8px_var(--cy)]"><FileCode class="size-6" /></span>
        <h3 class="mt-5 text-xl font-bold text-tx">Сразу в deck.yaml</h3>
        <p class="mt-2 text-[15px] leading-relaxed text-mu">Для презентаций, которые долго живут: схемы, графики, таблицы — родными блоками. Claude пишет такой файл сам по навыку slideria-deck.</p>
        <div class="mt-auto pt-6">
          <CodeBlock code={slide} dark class="text-[12px] [&_div.p-4]:py-3" />
        </div>
      </article>
    </div>

    <!-- путь презентации, как на втором слайде витрины -->
    <ol data-reveal class="relative mx-auto mt-16 grid max-w-4xl grid-cols-5 gap-2">
      <div aria-hidden="true" class="absolute left-[10%] right-[10%] top-[15px] h-px bg-gradient-to-r from-ac via-vi to-pk opacity-50">
        <span class="pulse-x absolute -top-[3px] size-[7px] rounded-full bg-ac shadow-[0_0_12px_var(--ac)]"></span>
        <span class="pulse-x absolute -top-[3px] size-[7px] rounded-full bg-pk shadow-[0_0_12px_var(--pk)]" style="--d:1.2s"></span>
      </div>
      {path.map((p, i) => (
        <li class="relative flex flex-col items-center text-center">
          <span class="relative z-10 grid size-8 place-items-center rounded-full border-2 border-ac bg-surf font-mono text-[12px] font-bold text-ac">{i + 1}</span>
          <b class="mt-2 text-[14px] text-tx">{p.title}</b>
          <span class="text-[12px] leading-snug text-mu">{p.sub}</span>
        </li>
      ))}
    </ol>
  </Container>
</section>
