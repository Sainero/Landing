---
import { BookOpen } from '@lucide/astro';
import DownloadLink from '@/entities/app/DownloadLink.astro';
import CloudLink from '@/entities/cloud/CloudLink.astro';
import Button from '@/shared/ui-kit/Button.astro';
import Container from '@/shared/ui-kit/Container.astro';
import LogoMark from '@/shared/ui-kit/LogoMark.astro';
import StageBackdrop from '@/shared/ui-kit/StageBackdrop.astro';

const title = ['Презентации,', 'которые', 'живут'];
---
<section data-anim class="relative isolate overflow-hidden py-28 sm:py-36">
  <StageBackdrop />

  <Container class="flex flex-col items-center text-center">
    <div data-reveal class="rounded-[26px] shadow-[0_0_0_12px_color-mix(in_srgb,var(--ac)_8%,transparent),0_14px_40px_-8px_rgba(37,99,235,.5)]">
      <LogoMark class="size-24" />
    </div>
    <h2 data-reveal class="font-display mt-8 flex flex-wrap justify-center gap-x-[.28em] text-[clamp(32px,6vw,72px)] font-bold leading-[1.05] tracking-[-.045em] text-tx">
      {title.map((w, i) => <span class={i === 2 ? 'text-gradient' : undefined}>{w}</span>)}
    </h2>
    <div data-reveal class="mx-auto mt-5 h-0.5 w-48 rounded bg-[linear-gradient(90deg,var(--ac),var(--pk))]"></div>
    <p data-reveal class="mt-5 text-lg tracking-wide text-tx2">Слайды как данные. Правка как в PowerPoint. Показ как кино.</p>

    <div data-reveal class="mt-10 flex flex-wrap justify-center gap-3">
      <DownloadLink variant="primary" size="lg" />
      <CloudLink variant="secondary" size="lg" />
      <Button href="/docs" variant="ghost" size="lg"><BookOpen class="size-4" />Документация</Button>
    </div>
  </Container>
</section>
