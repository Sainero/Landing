---
import { ArrowDown } from '@lucide/astro';
import CloudLink from '@/entities/cloud/CloudLink.astro';
import DeckStudio from '@/entities/deck/ui/DeckStudio.astro';
import { siteConfig } from '@/shared/lib/config';
import Button from '@/shared/ui-kit/Button.astro';
import CommandLine from '@/shared/ui-kit/CommandLine.astro';
import Container from '@/shared/ui-kit/Container.astro';
import Kbd from '@/shared/ui-kit/Kbd.astro';

const line1 = ['Презентации'];
const line2 = ['как', 'данные'];
const w = (k: number) => `--w:${(0.15 + k * 0.22).toFixed(2)}s`;
---
<section data-hero class="relative isolate overflow-hidden pb-16 pt-28 sm:pb-24 sm:pt-36">
  <!-- фон: сетка точек, свечение, прожектор за курсором -->
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
    <div class="dot-grid absolute inset-0 [mask-image:radial-gradient(ellipse_75%_60%_at_50%_30%,#000_35%,transparent_100%)]"></div>
    <div class="absolute left-1/2 top-[-260px] h-[620px] w-[1100px] -translate-x-1/2 rounded-full bg-[radial-gradient(closest-side,color-mix(in_srgb,var(--ac)_30%,transparent),transparent)] blur-2xl"></div>
    <div class="absolute right-[-160px] top-[260px] h-[460px] w-[460px] rounded-full bg-[radial-gradient(closest-side,color-mix(in_srgb,var(--vi)_22%,transparent),transparent)] blur-2xl"></div>
    <div class="absolute left-[-180px] top-[420px] h-[420px] w-[420px] rounded-full bg-[radial-gradient(closest-side,color-mix(in_srgb,var(--cy)_22%,transparent),transparent)] blur-2xl"></div>
    <div data-spotlight class="absolute inset-0 opacity-0 transition-opacity duration-500 [background:radial-gradient(500px_circle_at_var(--mx,50%)_var(--my,30%),color-mix(in_srgb,var(--ac)_10%,transparent),transparent_70%)]"></div>
  </div>

  <Container class="relative flex flex-col items-center text-center">
    <a href={siteConfig.github} target="_blank" rel="noopener" class="fade-up group mb-7 inline-flex items-center gap-2 rounded-full border border-bd bg-surf/70 py-1 pl-1 pr-3 text-[13px] font-semibold text-tx2 shadow-[var(--shadow-sm)] backdrop-blur transition hover:border-acb" style="--d:.05s">
      <span class="rounded-full bg-ac px-2 py-0.5 text-[11px] font-bold text-white">v{siteConfig.engine.version}</span>
      Открытый движок · {siteConfig.license}
      <span class="text-mu transition group-hover:translate-x-0.5">→</span>
    </a>

    <h1 class="text-[clamp(46px,9.2vw,112px)] font-extrabold leading-[.95] tracking-[-.045em] text-tx" aria-label="Презентации как данные">
      <span class="flex justify-center gap-x-[.24em]">{line1.map((x, k) => <span class="word" style={w(k)}>{x}</span>)}</span>
      <span class="flex justify-center gap-x-[.24em] pb-2">{line2.map((x, k) => <span class="word text-gradient" style={w(k + 1)}>{x}</span>)}</span>
    </h1>

    <p class="fade-up mt-6 max-w-2xl text-pretty text-[17px] leading-relaxed text-tx2 sm:text-xl" style="--d:.75s">
      Пишете слайды в YAML — получаете <b class="text-tx">один HTML-файл</b> с анимациями, темами и режимом докладчика.
      Открывается без интернета, отправляется по почте, печатается в PDF.
    </p>

    <div class="fade-up mt-9 flex flex-wrap items-center justify-center gap-3" style="--d:.9s">
      <Button href="#demo" variant="glow" size="lg">
        Смотреть живое демо <ArrowDown class="size-4 transition group-hover/btn:translate-y-0.5" />
      </Button>
      <CloudLink variant="secondary" size="lg" />
    </div>
    <CommandLine command={'yarn new q3-report "Итоги квартала"'} class="fade-up mt-5 w-full max-w-md" style="--d:1s" />
  </Container>

  <Container class="relative mt-16 sm:mt-20">
    <div id="demo" class="fade-up relative scroll-mt-24" style="--d:1.1s">
      <!-- кольца, как в финальном слайде -->
      <svg aria-hidden="true" class="pointer-events-none absolute left-1/2 top-[38%] -z-10 hidden size-[220px] -translate-x-1/2 overflow-visible md:block" viewBox="0 0 220 220">
        {[0, 1.5, 3, 4.5].map((d) => <circle class="ring" cx="110" cy="110" r="70" fill="none" stroke="var(--ac)" stroke-width="1" vector-effect="non-scaling-stroke" style={`--d:${d}s`} />)}
      </svg>

      <!-- плавающие метки -->
      <div aria-hidden="true" class="float-y absolute -left-3 -top-11 z-30 hidden items-center gap-2 rounded-xl border border-bd bg-surf/90 px-3 py-2 text-[12.5px] font-semibold text-tx shadow-[var(--shadow-md)] backdrop-blur md:flex">
        <span class="grid size-6 place-items-center rounded-md bg-acs text-ac">⌘</span> YAML → слайды за 0,6 с
      </div>
      <div aria-hidden="true" class="float-y absolute -right-3 -top-11 z-30 hidden items-center gap-2 rounded-xl border border-bd bg-surf/90 px-3 py-2 text-[12.5px] font-semibold text-tx shadow-[var(--shadow-md)] backdrop-blur md:flex" style="--d:-3s">
        <span class="size-2 rounded-full bg-ok shadow-[0_0_10px_var(--ok)]"></span> Работает офлайн
      </div>

      <DeckStudio deck="tour" />
    </div>
    <p class="mt-5 flex flex-wrap items-center justify-center gap-x-2 gap-y-2 text-center text-[13.5px] text-mu">
      Это не видео — настоящая собранная презентация. Щёлкните по ней и листайте
      <Kbd>←</Kbd><Kbd>→</Kbd>, <Kbd>O</Kbd> — обзор, <Kbd>P</Kbd> — окно докладчика, <Kbd>T</Kbd> — тема.
    </p>
  </Container>
</section>

<script>
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const spot = hero?.querySelector<HTMLElement>('[data-spotlight]');
  if (hero && spot && matchMedia('(pointer: fine)').matches) {
    hero.addEventListener('pointermove', (e) => {
      const r = hero.getBoundingClientRect();
      spot.style.setProperty('--mx', `${e.clientX - r.left}px`);
      spot.style.setProperty('--my', `${e.clientY - r.top}px`);
      spot.style.opacity = '1';
    });
    hero.addEventListener('pointerleave', () => { spot.style.opacity = '0'; });
  }
</script>
