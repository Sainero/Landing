---
import { Download, Globe, Plug, Workflow } from '@lucide/astro';
import CloudLink from '@/entities/cloud/CloudLink.astro';
import { isCloudLive } from '@/shared/lib/config';
import studioDark from '@/assets/shots/studio-dark.webp';
import Container from '@/shared/ui-kit/Container.astro';
import Shot from '@/shared/ui-kit/Shot.astro';

// Звёзды как в шаблоне space: детерминированный генератор, одинаково при каждой сборке
let seed = 7;
const rnd = () => (seed = (seed * 16807) % 2147483647) / 2147483647;
const stars = Array.from({ length: 90 }, () => ({ x: rnd() * 100, y: rnd() * 100, s: 0.6 + rnd() * 1.6 }));

const features = [
  { icon: Globe, title: 'Студия без установки', text: 'Тот же сервер и та же студия, что в программе, — открываются по адресу в браузере.' },
  { icon: Plug, title: 'Коннектор для агентов', text: 'MCP по HTTP со входом: адрес добавляется как свой коннектор в сервисы с поддержкой MCP — презентации правятся прямо из окна агента.' },
  { icon: Workflow, title: 'Данные из сервисов', text: 'Коннекторы к другим сервисам: вход, обновление данных на слайдах и снимок в экспорт.' },
  { icon: Download, title: 'Тот же формат', text: 'Любую презентацию можно скачать HTML-файлом, PowerPoint или PDF и показать офлайн.' },
];

const roadmap = [
  { stage: 'Этап 1', title: 'Формат и показ', text: 'Презентация как данные, блоки, один HTML-файл, окно докладчика, пульт', state: 'Готово', done: true },
  { stage: 'Этап 2', title: 'Студия и программа', text: 'Правка как в PowerPoint, импорт PPTX и HTML, экспорт, агенты и MCP', state: 'Готово', done: true },
  { stage: 'Этап 3', title: 'Облако', text: 'Студия по адресу, вход, коннектор для агентов, данные из сервисов', state: 'В планах' },
];
---
<section id="cloud" data-anim class="relative isolate overflow-hidden bg-[#05070F] py-24 text-[#E6EBF3] sm:py-32">
  <!-- космос: звёзды, туманности, луч -->
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_60%_50%_at_20%_10%,rgba(37,99,235,.28),transparent),radial-gradient(ellipse_50%_40%_at_85%_80%,rgba(236,72,153,.18),transparent),radial-gradient(ellipse_40%_30%_at_70%_15%,rgba(99,102,241,.22),transparent)]"></div>
    <!-- звёзды — одна статичная картинка, а не 90 мигающих слоёв -->
    <svg class="absolute inset-0 size-full">
      {stars.map((s) => <circle cx={`${s.x.toFixed(1)}%`} cy={`${s.y.toFixed(1)}%`} r={(s.s / 2).toFixed(2)} fill="#fff" opacity={(0.3 + s.s / 3).toFixed(2)} />)}
    </svg>
    <div class="beam absolute inset-y-0 left-0 w-56 bg-gradient-to-r from-transparent via-[rgba(147,197,253,.07)] to-transparent"></div>
  </div>

  <Container>
    <div data-reveal class="mx-auto flex max-w-3xl flex-col items-center text-center">
      <span class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/5 px-3.5 py-1.5 text-[12px] font-bold uppercase tracking-[.16em] text-white/80">
        <span class="size-1.5 rounded-full bg-[#6EE7B7] shadow-[0_0_10px_#6EE7B7]"></span> Slideria Cloud · {isCloudLive ? 'открыто' : 'скоро'}
      </span>
      <h2 class="font-display mt-6 text-balance text-[clamp(30px,5vw,58px)] font-bold leading-[1.06] tracking-[-.04em]">
        Та же студия —<br class="hidden sm:block" />
        <span class="bg-[linear-gradient(100deg,#93C5FD,#A5B4FC_45%,#F9A8D4)] bg-clip-text text-transparent">прямо в браузере</span>
      </h2>
      <p class="mt-5 max-w-2xl text-pretty text-[17px] leading-relaxed text-white/65 sm:text-lg">
        Облачная версия — отдельное приложение на своём адресе. Сайт остаётся витриной и документацией, программа для компьютера — сама по себе, а работать с презентациями можно будет и без установки.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <CloudLink variant="glow" size="lg" label={isCloudLive ? 'Открыть облако' : 'Облачная версия'} />
        <a href="/docs/roadmap" class="inline-flex h-13 items-center rounded-xl border border-white/15 bg-white/5 px-6 font-semibold text-white/85 transition hover:border-white/30 hover:bg-white/10">Что дальше</a>
      </div>
    </div>

    <!-- студия в окне браузера -->
    <div data-reveal class="relative mx-auto mt-16 max-w-5xl" style="--d:.1s">
      <div aria-hidden="true" class="absolute -inset-x-10 -top-10 bottom-0 -z-10 bg-[radial-gradient(closest-side,rgba(59,130,246,.35),transparent)]"></div>
      <figure class="overflow-hidden rounded-2xl border border-white/10 bg-[#0B1120] shadow-[0_40px_120px_-30px_rgba(37,99,235,.55)]">
        <div class="flex items-center gap-3 border-b border-white/10 px-4 py-2.5">
          <span class="flex gap-1.5"><i class="size-2.5 rounded-full bg-white/15"></i><i class="size-2.5 rounded-full bg-white/15"></i><i class="size-2.5 rounded-full bg-white/15"></i></span>
          <span class="mx-auto rounded-lg bg-white/5 px-3 py-1 font-mono text-[11.5px] text-white/50">app.slideria…/<b class="text-white/80">studio</b></span>
        </div>
        <Shot light={studioDark} alt="Студия Slideria в тёмной теме" sizes="(min-width: 1060px) 1024px, 100vw" />
      </figure>
      <p class="mt-4 text-center text-[12.5px] text-white/60">Так студия выглядит сейчас в программе. В облаке — она же.</p>
    </div>

    <!-- Что будет в облаке -->
    <div class="mt-20 grid grid-cols-[minmax(0,1fr)] gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {features.map((f, i) => (
        <div data-reveal class="rounded-2xl border border-white/10 bg-white/[.03] p-5 transition hover:border-white/20 hover:bg-white/[.06]" style={`--d:${(i % 4) * 0.06}s`}>
          <span class="grid size-10 place-items-center rounded-xl bg-[#3B82F6]/15 text-[#93C5FD]"><f.icon class="size-5" /></span>
          <h3 class="mt-4 text-[16px] font-bold">{f.title}</h3>
          <p class="mt-1.5 text-[14px] leading-relaxed text-white/60">{f.text}</p>
        </div>
      ))}
    </div>

    <!-- План -->
    <ol data-reveal class="relative mt-16 grid gap-4 md:grid-cols-3">
      <div aria-hidden="true" class="absolute left-0 right-0 top-[21px] hidden h-px bg-gradient-to-r from-[#3B82F6] via-[#3B82F6] to-white/10 md:block"></div>
      {roadmap.map((r, i) => (
        <li class="relative">
          <span class:list={['relative z-10 grid size-[42px] place-items-center rounded-full border-2 text-[13px] font-bold', r.done ? 'border-[#3B82F6] bg-[#3B82F6] text-white shadow-[0_0_24px_rgba(59,130,246,.7)]' : 'border-white/20 bg-[#05070F] text-white/60']}>
            {r.done ? '✓' : i + 1}
          </span>
          <div class="mt-4 text-[12px] font-bold uppercase tracking-[.14em] text-white/60">{r.stage} · <span class={r.done ? 'text-[#6EE7B7]' : 'text-white/60'}>{r.state}</span></div>
          <h3 class="mt-1 text-lg font-bold">{r.title}</h3>
          <p class="mt-1 text-[14px] leading-relaxed text-white/60">{r.text}</p>
        </li>
      ))}
    </ol>
  </Container>
</section>
