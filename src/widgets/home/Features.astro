---
import { Clapperboard, FileDown, Keyboard, Moon, PencilLine, Play, Presentation, Smartphone, Sun } from '@lucide/astro';
import PresenterPreview from '@/entities/deck/ui/PresenterPreview.astro';
import Container from '@/shared/ui-kit/Container.astro';
import Kbd from '@/shared/ui-kit/Kbd.astro';
import SectionHeading from '@/shared/ui-kit/SectionHeading.astro';

const keys = [
  { k: '→', label: 'дальше', codes: 'ArrowRight ArrowDown PageDown Space' },
  { k: 'O', label: 'обзор', codes: 'o щ' },
  { k: 'P', label: 'докладчик', codes: 'p з' },
  { k: 'R', label: 'пульт', codes: 'r к' },
  { k: 'A', label: 'автопоказ', codes: 'a ф' },
  { k: 'T', label: 'тема', codes: 't е' },
  { k: 'B', label: 'пауза', codes: 'b и .' },
  { k: 'E', label: 'правка', codes: 'e у' },
];
const formats = [
  { ext: 'HTML', color: '#2563EB', text: 'для показа или с редактором' },
  { ext: 'PPTX', color: '#D24726', text: 'тексты текстом, заметки на месте' },
  { ext: 'PDF', color: '#DC2626', text: 'слайд на страницу, с фонами' },
];
const card = 'group/card relative overflow-hidden rounded-3xl border border-bd bg-surf p-6 shadow-[var(--shadow-sm)] transition duration-300 hover:-translate-y-0.5 hover:border-acb/70 hover:shadow-[var(--shadow-md)]';
const icon = 'grid size-10 place-items-center rounded-xl bg-acs text-ac';
---
<section id="features" class="relative py-24 sm:py-32">
  <div aria-hidden="true" class="dot-grid pointer-events-none absolute inset-0 -z-10 [mask-image:linear-gradient(transparent,#000_20%,#000_80%,transparent)]"></div>
  <Container>
    <SectionHeading eyebrow="Показ и экспорт" lead="Всё, что нужно на сцене, уже встроено: окна раскладываются по экранам, телефон становится пультом, а файл уходит в нужном формате.">
      <Fragment slot="title">Показ как <span class="text-gradient">кино</span></Fragment>
    </SectionHeading>

    <div class="mt-16 grid grid-cols-[minmax(0,1fr)] gap-4 md:grid-cols-6">
      <!-- Режим докладчика: настоящее окно Slideria, листается вместе с демо наверху -->
      <article data-reveal class:list={[card, 'flex flex-col md:col-span-4 md:row-span-2']}>
        <div class="flex items-start gap-4">
          <span class={icon}><Presentation class="size-5" /></span>
          <div>
            <h3 class="text-lg font-bold text-tx">Режим докладчика</h3>
            <p class="mt-1 max-w-lg text-[15px] leading-relaxed text-mu">Как в PowerPoint: показ уходит на проектор, окно докладчика — к вам. Текущий и следующий слайд, заметки, таймер, указка и перо.</p>
          </div>
        </div>
        <div class="relative mt-6 flex-1">
          <div class="overflow-hidden rounded-2xl border border-bd2/70 shadow-[var(--shadow-md)]">
            <PresenterPreview deck="slideria" />
          </div>
          <span class="absolute -bottom-2 right-4 inline-flex items-center gap-1.5 rounded-full border border-bd bg-surf px-2.5 py-1 text-[11.5px] font-semibold text-tx2 shadow-[var(--shadow-sm)]">
            <span class="size-1.5 rounded-full bg-ok"></span> живое окно листается вместе с витриной наверху
          </span>
        </div>
      </article>

      <!-- Пульт -->
      <article data-reveal class:list={[card, 'md:col-span-2']} style="--d:.05s">
        <span class={icon}><Smartphone class="size-5" /></span>
        <h3 class="mt-4 text-lg font-bold text-tx">Пульт с телефона</h3>
        <p class="mt-1 text-[15px] leading-relaxed text-mu">Клавиша <Kbd>R</Kbd> — QR-код. Телефон листает, показывает заметки и таймер, рисует пером. Код одноразовый.</p>
        <div class="mt-5 flex items-center gap-4">
          <div class="relative h-[92px] w-[50px] rounded-[12px] border-2 border-tx/80 bg-surf p-1">
            <div class="h-full rounded-[7px] bg-[linear-gradient(160deg,var(--ac),var(--vi))] p-1"><div class="h-2.5 rounded bg-white/80"></div><div class="mt-1 h-1 w-6 rounded bg-white/50"></div></div>
          </div>
          <div class="grid size-[72px] grid-cols-6 gap-[2px] rounded-lg border border-bd bg-white p-1.5" aria-hidden="true">
            {Array.from({ length: 36 }, (_, i) => <i class:list={['rounded-[1px]', (i * 7 + (i >> 2)) % 3 ? 'bg-[#0B1220]' : 'bg-transparent']}></i>)}
          </div>
        </div>
      </article>

      <!-- Экспорт -->
      <article data-reveal class:list={[card, 'md:col-span-2']} style="--d:.1s">
        <span class={icon}><FileDown class="size-5" /></span>
        <h3 class="mt-4 text-lg font-bold text-tx">Один файл — любой формат</h3>
        <p class="mt-1 text-[15px] leading-relaxed text-mu">«Файл» → «Экспорт». HTML открывается без интернета: слайды, шрифты, видео внутри.</p>
        <ul class="mt-4 flex flex-col gap-2">
          {formats.map((f) => (
            <li class="flex items-center gap-3 rounded-xl border border-bd bg-alt/60 px-2.5 py-2">
              <span class="w-12 rounded-md py-0.5 text-center font-mono text-[10.5px] font-bold text-white" style={`background:${f.color}`}>{f.ext}</span>
              <span class="text-[13px] text-tx2">{f.text}</span>
            </li>
          ))}
        </ul>
      </article>

      <!-- Клавиатура -->
      <article data-reveal class:list={[card, 'md:col-span-3']} data-keys-card>
        <span class={icon}><Keyboard class="size-5" /></span>
        <h3 class="mt-4 text-lg font-bold text-tx">Всё с клавиатуры</h3>
        <p class="mt-1 text-[15px] leading-relaxed text-mu">Буквы работают и в русской раскладке. Нажмите любую — она подсветится.</p>
        <div class="mt-5 grid grid-cols-4 gap-2">
          {keys.map((x) => (
            <div data-key={x.codes} class="flex flex-col items-center gap-1 rounded-xl border border-bd bg-alt/60 py-2.5 transition data-[hit]:border-ac data-[hit]:bg-acs">
              <span class="grid h-8 min-w-8 place-items-center rounded-lg border border-bd2 border-b-[3px] bg-surf px-1.5 font-mono text-[13px] font-bold text-tx">{x.k}</span>
              <span class="text-[11.5px] text-mu">{x.label}</span>
            </div>
          ))}
        </div>
      </article>

      <!-- Правка прямо в файле -->
      <article data-reveal class:list={[card, 'md:col-span-3']} style="--d:.05s">
        <span class={icon}><PencilLine class="size-5" /></span>
        <h3 class="mt-4 text-lg font-bold text-tx">Правка прямо в файле</h3>
        <p class="mt-1 text-[15px] leading-relaxed text-mu">Коллега открыл HTML, нажал <Kbd>E</Kbd>, поправил текст и картинки и прислал файл обратно. Импорт перенесёт правки в deck.yaml — слиянием, а не заменой.</p>
        <div class="mt-5 rounded-xl border border-bd bg-alt/60 p-3.5 text-[13px]">
          <div class="flex items-center justify-between"><b class="text-tx">Импорт правок · q3-report.html</b><span class="rounded-full bg-ok/15 px-2 py-0.5 text-[11px] font-bold text-ok">3 изменения</span></div>
          <ul class="mt-2 flex flex-col gap-1 font-mono text-[12px] text-tx2">
            <li><span class="text-ok">~</span> слайд 2 · заголовок</li>
            <li><span class="text-ok">~</span> слайд 5 · картинка → assets/</li>
            <li><span class="text-ok">+</span> слайд 7 · заметки</li>
          </ul>
        </div>
      </article>

      <!-- Автопоказ -->
      <article data-reveal class:list={[card, 'md:col-span-2']}>
        <span class={icon}><Play class="size-5" /></span>
        <h3 class="mt-4 text-lg font-bold text-tx">Автопоказ</h3>
        <p class="mt-1 text-[15px] leading-relaxed text-mu"><Kbd>A</Kbd> — слайды листаются сами, как видео: после анимаций и роликов. Ещё раз <Kbd>A</Kbd> — пауза.</p>
        <div class="mt-5 flex gap-1" aria-hidden="true">
          {[1, 1, 1, 0.55, 0, 0, 0].map((f) => <span class="h-1.5 flex-1 overflow-hidden rounded-full bg-bd"><span class="block h-full rounded-full bg-ac" style={`width:${f * 100}%`}></span></span>)}
        </div>
      </article>

      <!-- Анимации -->
      <article data-reveal class:list={[card, 'md:col-span-2']} style="--d:.05s">
        <span class={icon}><Clapperboard class="size-5" /></span>
        <h3 class="mt-4 text-lg font-bold text-tx">Анимации и морф</h3>
        <p class="mt-1 text-[15px] leading-relaxed text-mu">21 эффект появления, 18 переходов, «Морф» между слайдами, эффекты текста и число, которое набегает.</p>
        <div class="mt-4 font-display text-[34px] font-bold leading-none tracking-tight text-gradient">21 · 18</div>
      </article>

      <!-- Темы -->
      <article data-reveal class:list={[card, 'md:col-span-2']} style="--d:.1s">
        <span class={icon}><Moon class="size-5" /></span>
        <h3 class="mt-4 text-lg font-bold text-tx">Светлая и тёмная</h3>
        <p class="mt-1 text-[15px] leading-relaxed text-mu">Темы презентации строят обе версии сами, у зрителя — по его системе или клавишей <Kbd>T</Kbd>. Попробуйте:</p>
        <button type="button" data-theme-toggle class="mt-4 flex w-full items-center gap-3 rounded-2xl border border-bd bg-alt/70 p-2 text-left transition hover:border-acb">
          <span class="relative h-9 w-16 rounded-full bg-bd2/70 p-1">
            <span class="grid size-7 place-items-center rounded-full bg-surf text-ac shadow transition-transform duration-500 dark:translate-x-7">
              <Sun class="size-4 dark:hidden" /><Moon class="hidden size-4 dark:block" />
            </span>
          </span>
          <span class="text-[13.5px] font-semibold text-tx2">Сайт и презентации на странице</span>
        </button>
      </article>
    </div>
  </Container>
</section>

<script>
  const card = document.querySelector<HTMLElement>('[data-keys-card]');
  if (card) {
    const cells = [...card.querySelectorAll<HTMLElement>('[data-key]')].map((el) => ({ el, codes: el.dataset.key!.split(' ') }));
    document.addEventListener('keydown', (e) => {
      if (e.ctrlKey || e.metaKey || e.altKey) return;
      const tag = (e.target as HTMLElement)?.tagName;
      if (tag === 'INPUT' || tag === 'TEXTAREA') return;
      const key = e.key === ' ' ? 'Space' : e.key.length === 1 ? e.key.toLowerCase() : e.key;
      const hit = cells.find((c) => c.codes.includes(key));
      if (!hit) return;
      hit.el.setAttribute('data-hit', '');
      setTimeout(() => hit.el.removeAttribute('data-hit'), 450);
    });
  }
</script>
