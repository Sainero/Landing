---
const items = [
  'Один HTML-файл', 'Работает без интернета', 'Светлая и тёмная тема', 'Режим докладчика', 'Печать в PDF',
  'QR-код из ссылки', 'Свайпы на телефоне', 'Ошибки с номером строки', '25 компонентов', 'Синхронизация окон',
  'Обзор слайдов', 'Чёрный экран', 'Анимации появления', 'Номер слайда в адресе',
];
---
<section aria-label="Коротко о возможностях" class="relative border-y border-bd bg-surf/60 py-4">
  <div class="overflow-hidden [mask-image:linear-gradient(90deg,transparent,#000_8%,#000_92%,transparent)]">
    <div class="marquee flex w-max gap-3 hover:[animation-play-state:paused]">
      {[...items, ...items].map((t, i) => (
        <span class="inline-flex items-center gap-3 whitespace-nowrap text-[14px] font-semibold text-tx2" aria-hidden={i >= items.length ? 'true' : undefined}>
          <span class="size-1.5 rounded-full bg-ac/60"></span>{t}
        </span>
      ))}
    </div>
  </div>
</section>
