---
const items = [
  'Студия как PowerPoint', 'Один HTML-файл', 'Экспорт в PowerPoint и PDF', 'Импорт из PowerPoint', 'Импорт из Claude Design',
  'Окно докладчика', 'Пульт с телефона', 'Автопоказ', 'Морф', '21 эффект появления', '18 переходов', 'Формулы',
  '3D-модели', 'Диаграммы из текста', 'Цвет+ для фото', 'Темы и свои шрифты', 'Агент в студии', 'MCP для Claude',
];
---
<section aria-label="Коротко о возможностях" data-anim class="relative border-y border-bd bg-surf/60 py-4">
  <div class="overflow-hidden [mask-image:linear-gradient(90deg,transparent,#000_8%,#000_92%,transparent)]">
    <div class="marquee flex w-max gap-3 hover:[animation-play-state:paused]">
      {[...items, ...items].map((t, i) => (
        <span class="inline-flex items-center gap-3 whitespace-nowrap text-[14px] font-semibold text-tx2" aria-hidden={i >= items.length ? 'true' : undefined}>
          <span class="size-1.5 rounded-full bg-ac/60"></span>{t}
        </span>
      ))}
    </div>
  </div>
</section>
