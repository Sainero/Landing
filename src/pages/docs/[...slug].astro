---
import { render } from 'astro:content';
import DocsLayout from '@/app/layouts/DocsLayout.astro';
import { docHref, docsNav, type DocEntry } from '@/widgets/docs/docsNav';

export async function getStaticPaths() {
  const { all } = await docsNav();
  return all.map((entry, i) => ({
    params: { slug: entry.id === 'index' ? undefined : entry.id },
    props: { entry, prev: all[i - 1], next: all[i + 1] },
  }));
}

interface Props { entry: DocEntry; prev?: DocEntry; next?: DocEntry }
const { entry, prev, next } = Astro.props;
const { Content, headings } = await render(entry);
const link = (d?: DocEntry) => (d ? { href: docHref(d), title: d.data.title } : undefined);
---
<DocsLayout
  title={entry.data.title}
  description={entry.data.description}
  group={entry.data.group}
  current={entry.id}
  headings={headings}
  prev={link(prev)}
  next={link(next)}
>
  <Content />
</DocsLayout>
