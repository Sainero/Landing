---
import { cn } from '../lib/cn';
import LogoMark from './LogoMark.astro';

interface Props { class?: string; withText?: boolean }
const { class: cls, withText = true } = Astro.props;
---
<span class={cn('inline-flex items-center gap-2.5', cls)}>
  <span class="grid size-9 place-items-center rounded-[11px] border border-acb/70 bg-surf shadow-[0_2px_8px_rgba(37,99,235,.14)]">
    <LogoMark class="size-6" />
  </span>
  {withText && (
    <span class="text-[17px] font-extrabold tracking-[-.01em] text-tx">HTML<span class="text-ac">PPTX</span></span>
  )}
</span>
