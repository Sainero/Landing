---
import { cn } from '../lib/cn';
import LogoMark from './LogoMark.astro';

interface Props { class?: string; withText?: boolean }
const { class: cls, withText = true } = Astro.props;
---
<span class={cn('inline-flex items-center gap-2.5', cls)}>
  <LogoMark class="size-9 shrink-0 drop-shadow-[0_4px_10px_rgba(37,99,235,.3)]" />
  {withText && <span class="font-display text-[17px] font-semibold tracking-[-.01em] text-tx">Slideria</span>}
</span>
