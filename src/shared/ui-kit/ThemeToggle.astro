---
import { Moon, Sun } from '@lucide/astro';
import { cn } from '../lib/cn';

/** Переключатель темы. Логика — в shared/lib/client/site.ts ([data-theme-toggle]). */
interface Props { class?: string }
const { class: cls } = Astro.props;
---
<button
  type="button"
  data-theme-toggle
  aria-label="Переключить тему"
  title="Светлая / тёмная тема"
  class={cn('relative grid size-9 place-items-center rounded-full border border-bd bg-surf text-ac shadow-[var(--shadow-sm)] transition hover:border-acb', cls)}
>
  <Sun class="absolute size-[18px] transition duration-500 dark:-rotate-90 dark:scale-50 dark:opacity-0" stroke-width={1.8} />
  <Moon class="absolute size-[17px] rotate-90 scale-50 opacity-0 transition duration-500 dark:rotate-0 dark:scale-100 dark:opacity-100" stroke-width={1.8} />
</button>
