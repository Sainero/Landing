---
import { cn } from '../lib/cn';
import Eyebrow from './Eyebrow.astro';

/** Заголовок секции: метка, заголовок (slot="title" или title), подводка */
interface Props { eyebrow?: string; title?: string; lead?: string; align?: 'center' | 'left'; class?: string }
const { eyebrow, title, lead, align = 'center', class: cls } = Astro.props;
---
<div data-reveal class={cn('flex flex-col gap-4', align === 'center' ? 'mx-auto max-w-3xl items-center text-center' : 'max-w-2xl items-start', cls)}>
  {eyebrow && <Eyebrow>{eyebrow}</Eyebrow>}
  <h2 class="font-display text-balance text-[clamp(28px,4.2vw,48px)] font-bold leading-[1.08] tracking-[-.04em] text-tx">
    <slot name="title">{title}</slot>
  </h2>
  {lead && <p class="text-pretty text-[17px] leading-relaxed text-mu sm:text-lg">{lead}</p>}
</div>
