---
import { Code } from 'astro:components';
import { cn } from '../lib/cn';
import CopyButton from './CopyButton.astro';

/**
 * Блок кода с подсветкой Shiki (на этапе сборки, без JS в браузере).
 * dark — всегда тёмный «редактор», иначе цвета следуют теме сайта.
 */
interface Props {
  code: string;
  lang?: 'yaml' | 'ts' | 'bash' | 'css' | 'json' | 'html';
  file?: string;
  dark?: boolean;
  lines?: boolean;
  class?: string;
}
const { code, lang = 'yaml', file, dark = false, lines = false, class: cls } = Astro.props;
const text = code.trim();
---
<div class={cn('overflow-hidden rounded-2xl border', dark ? 'border-white/10 bg-[#0B1020] text-[#E6EDF3] shadow-[var(--shadow-lg)]' : 'border-bd bg-surf shadow-[var(--shadow-sm)]', cls)}>
  {file && (
    <div class={cn('flex items-center gap-2 border-b px-4 py-2', dark ? 'border-white/10' : 'border-bd')}>
      <span class="flex gap-1.5"><i class="size-2.5 rounded-full bg-[#FF5F57]"></i><i class="size-2.5 rounded-full bg-[#FEBC2E]"></i><i class="size-2.5 rounded-full bg-[#28C840]"></i></span>
      <span class={cn('ml-2 font-mono text-xs', dark ? 'text-white/55' : 'text-mu')}>{file}</span>
      <CopyButton text={text} class={cn('ml-auto size-7', dark && 'text-white/50 hover:bg-white/10 hover:text-white')} />
    </div>
  )}
  <div class={cn('overflow-x-auto p-4 font-mono text-[13px] leading-[1.7] [&_pre]:!m-0', lines && 'code-lines')}>
    {dark
      ? <Code code={text} lang={lang} theme="github-dark-default" />
      : <Code code={text} lang={lang} themes={{ light: 'github-light', dark: 'github-dark' }} defaultColor="light" />}
  </div>
</div>
