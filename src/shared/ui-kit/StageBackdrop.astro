---
/**
 * Фон-«сцена» для первого и финального экранов: показ как кино.
 * Сзади — сияние (три мягких цветовых поля медленно дрейфуют), сверху — луч прожектора,
 * снизу — пол-сетка, уходящая к горизонту, поверх — плёночное зерно.
 * Двигаются только transform и opacity (их считает видеокарта); за экраном секция с data-anim стоит.
 */
interface Props { floor?: boolean; class?: string }
const { floor = false, class: cls } = Astro.props;
---
<div aria-hidden="true" class:list={['stage', cls]}>
  <div class="stage-aurora"><i></i><i></i><i></i></div>
  <div class="stage-beam"></div>
  {floor && <div class="stage-floor"><div></div></div>}
  <div class="stage-grain"></div>
</div>
