---
/** Каркас документации: сайдбар разделов, статья, оглавление страницы. */
import type { MarkdownHeading } from 'astro';
import { ChevronDown, Pencil } from '@lucide/astro';
import { siteConfig } from '@/shared/lib/config';
import Container from '@/shared/ui-kit/Container.astro';
import DocsSidebar from '@/widgets/docs/DocsSidebar.astro';
import SiteLayout from './SiteLayout.astro';

interface Props {
  title: string;
  description?: string;
  current: string;
  group: string;
  headings: MarkdownHeading[];
  prev?: { href: string; title: string };
  next?: { href: string; title: string };
}
const { title, description, current, group, headings, prev, next } = Astro.props;
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const source = current === 'components' ? 'docs/COMPONENTS.md' : 'README.md';
---
<SiteLayout title={title} description={description}>
  <Container class="pt-24 sm:pt-28">
    <div class="grid grid-cols-[minmax(0,1fr)] gap-10 pb-24 lg:grid-cols-[230px_minmax(0,1fr)] xl:grid-cols-[230px_minmax(0,1fr)_220px]">
      <aside class="hidden lg:block">
        <div class="sticky top-24 max-h-[calc(100dvh-7rem)] overflow-y-auto pb-6"><DocsSidebar current={current} /></div>
      </aside>

      <details class="group/m rounded-2xl border border-bd bg-surf lg:hidden">
        <summary class="flex cursor-pointer list-none items-center justify-between px-4 py-3 text-[15px] font-semibold text-tx [&::-webkit-details-marker]:hidden">
          <span><span class="text-mu">{group} /</span> {title}</span>
          <ChevronDown class="size-4 transition group-open/m:rotate-180" />
        </summary>
        <div class="border-t border-bd p-3"><DocsSidebar current={current} /></div>
      </details>

      <article class="min-w-0">
        <div class="mb-8">
          <div class="text-[13px] font-semibold text-ac">{group}</div>
          <h1 class="mt-2 text-[clamp(32px,4.5vw,44px)] font-extrabold leading-[1.1] tracking-[-.03em] text-tx">{title}</h1>
          {description && <p class="mt-3 text-lg text-mu">{description}</p>}
        </div>
        <div class="prose-doc"><slot /></div>

        <div class="mt-14 flex flex-wrap items-center justify-between gap-3 border-t border-bd pt-6 text-[13.5px] text-mu">
          <span>Источник: <code class="font-mono">HTMLPPTX/{source}</code> · движок v{siteConfig.engine.version}</span>
          <a href={`${siteConfig.github}/blob/main/${source}`} target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 font-semibold text-ac hover:underline"><Pencil class="size-3.5" />Править на GitHub</a>
        </div>
        <nav class="mt-6 grid gap-3 sm:grid-cols-2" aria-label="Соседние страницы">
          {prev ? <a href={prev.href} class="rounded-2xl border border-bd p-4 transition hover:border-acb"><small class="text-mu">← Назад</small><b class="block text-tx">{prev.title}</b></a> : <span></span>}
          {next && <a href={next.href} class="rounded-2xl border border-bd p-4 text-right transition hover:border-acb"><small class="text-mu">Далее →</small><b class="block text-tx">{next.title}</b></a>}
        </nav>
      </article>

      {toc.length > 1 && (
        <aside class="hidden xl:block">
          <div class="sticky top-24 max-h-[calc(100dvh-7rem)] overflow-y-auto">
            <h2 class="mb-3 text-[11.5px] font-bold uppercase tracking-[.14em] text-mu">На этой странице</h2>
            <ul class="flex flex-col gap-1.5 border-l border-bd text-[13px]">
              {toc.map((h) => (
                <li><a href={`#${h.slug}`} class:list={['-ml-px block border-l border-transparent text-mu transition hover:border-ac hover:text-tx', h.depth === 3 ? 'pl-6' : 'pl-3']}>{h.text}</a></li>
              ))}
            </ul>
          </div>
        </aside>
      )}
    </div>
  </Container>
</SiteLayout>
