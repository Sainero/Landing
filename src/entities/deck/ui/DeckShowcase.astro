---
/**
 * Витрина на первом экране: окно браузера с кадром слайда и вкладки слайдов под ним.
 * До щелчка «Запустить показ» — кадры (лёгкие картинки), после — сама собранная презентация во фрейме.
 * Вкладки, автопрокрутка и показ связаны протоколом Slideria (lib/protocol.ts).
 */
import { deckSize, sizeLabel } from '@/shared/lib/config';
import { readDeck } from '../lib/readDeck';

interface Props { deck: string; class?: string }
const { deck: name, class: cls } = Astro.props;
const deck = await readDeck(name);
const size = sizeLabel(deckSize(name));
---
<div data-showcase={name} data-title={deck.title} class:list={['group/showcase relative mx-auto flex max-w-[1040px] flex-col gap-3', cls]}>
  <!-- Окно браузера: кадр слайда, а по щелчку — сама презентация -->
  <div class="overflow-hidden rounded-2xl border border-bd2/70 bg-surf shadow-[var(--shadow-lg)]">
    <div class="flex items-center gap-3 border-b border-bd px-4 py-2.5">
      <span class="flex gap-1.5" aria-hidden="true"><i class="size-2.5 rounded-full bg-bd2"></i><i class="size-2.5 rounded-full bg-bd2"></i><i class="size-2.5 rounded-full bg-bd2"></i></span>
      <div class="mx-auto flex min-w-0 items-center gap-2 rounded-lg bg-alt px-3 py-1 font-mono text-[11.5px] text-mu">
        <span class="truncate">file:///Загрузки/<b class="font-semibold text-tx">{name}.html</b></span>
      </div>
      <span class="hidden rounded-md border border-bd px-1.5 py-0.5 font-mono text-[10.5px] font-semibold text-mu sm:inline">{size}</span>
    </div>
    <div class="[container-type:inline-size]">
      <div data-stage class="relative h-[calc(56px+56.25cqw)] bg-alt">
        <button type="button" data-poster class="absolute inset-x-0 top-0 block aspect-video w-full cursor-pointer overflow-hidden" aria-label="Запустить показ витрины">
          <img data-look="light" src={`/demo/posters/${name}/light-1.webp`} width="1280" height="720" alt="" loading="lazy" decoding="async" class="poster-in block size-full object-cover dark:hidden" />
          <img data-look="dark" src={`/demo/posters/${name}/dark-1.webp`} width="1280" height="720" alt="" loading="lazy" decoding="async" class="poster-in hidden size-full object-cover dark:block" />
        </button>
        <div data-poster-bar class="absolute inset-x-0 bottom-0 flex h-14 items-center gap-3 border-t border-bd bg-surf px-3 sm:px-4">
          <span class="font-mono text-[12px] text-mu" data-poster-count>1 из {deck.slides.length}</span>
          <button type="button" data-live-start class="mx-auto inline-flex h-9 items-center gap-2 rounded-xl bg-ac px-4 text-[14px] font-semibold text-white shadow-[0_8px_24px_-8px_rgba(37,99,235,.7)] transition hover:bg-ach disabled:opacity-70">
            <svg viewBox="0 0 24 24" class="size-4" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z" /></svg>
            <span data-live-label>Запустить показ</span>
          </button>
          <span class="w-[52px] max-sm:hidden" aria-hidden="true"></span>
        </div>
      </div>
    </div>
  </div>

  <!-- Вкладки слайдов с автопрокруткой -->
  <div role="tablist" aria-label="Слайды витрины">
    <div class="-mx-4 flex gap-2 overflow-x-auto px-4 pb-1 [scrollbar-width:none] sm:mx-0 sm:px-0">
      {deck.slides.map((s, i) => (
        <button
          type="button"
          role="tab"
          data-slide-tab={i}
          aria-selected={i === 0 ? 'true' : 'false'}
          class="group/tab relative flex min-w-[140px] flex-1 items-center gap-2 overflow-hidden rounded-xl border border-bd bg-surf px-3 py-2.5 text-left transition hover:border-acb aria-selected:border-acb aria-selected:bg-acs"
        >
          <span class="grid size-5 shrink-0 place-items-center rounded-full bg-alt font-mono text-[10.5px] font-bold text-tx2 group-aria-selected/tab:bg-ac group-aria-selected/tab:text-white">{i + 1}</span>
          <span class="truncate text-[13px] font-semibold text-tx2 group-aria-selected/tab:text-tx">{s.label}</span>
          <span data-tab-progress class="absolute inset-x-0 bottom-0 h-0.5 origin-left scale-x-0 bg-ac"></span>
        </button>
      ))}
    </div>
  </div>
</div>

<style>
  [data-showcase][data-autoplay] [aria-selected='true'] [data-tab-progress] {
    animation: tab-fill var(--slide-ms, 7000ms) linear both;
  }
  [data-showcase][data-paused] [data-tab-progress] { animation-play-state: paused !important; }
  @keyframes tab-fill { to { transform: scaleX(1); } }
</style>

<script>
  import { createDeckFrame, posterUrl, siteLook } from '../lib/live';
  import { readEnvelope, send } from '../lib/protocol';

  const SLIDE_MS = 7000;

  document.querySelectorAll<HTMLElement>('[data-showcase]').forEach((showcase) => {
    const deck = showcase.dataset.showcase!;
    const stage = showcase.querySelector<HTMLElement>('[data-stage]')!;
    const poster = showcase.querySelector<HTMLElement>('[data-poster]')!;
    const posterBar = showcase.querySelector<HTMLElement>('[data-poster-bar]')!;
    const posterCount = showcase.querySelector<HTMLElement>('[data-poster-count]')!;
    const startBtn = showcase.querySelector<HTMLButtonElement>('[data-live-start]')!;
    const imgs = [...poster.querySelectorAll<HTMLImageElement>('img[data-look]')];
    const tabs = [...showcase.querySelectorAll<HTMLButtonElement>('[data-slide-tab]')];
    const n = tabs.length;
    let frame: HTMLIFrameElement | null = null;
    let index = 0;
    let expected = 0;
    let autoplay = !matchMedia('(prefers-reduced-motion: reduce)').matches;
    let hovered = false;
    let visible = false;
    let timer = 0;

    showcase.style.setProperty('--slide-ms', `${SLIDE_MS}ms`);

    const showPoster = (i: number) => {
      imgs.forEach((img) => {
        img.src = posterUrl(deck, i, img.dataset.look as 'light' | 'dark');
        img.classList.remove('poster-in');
        void img.offsetWidth;
        img.classList.add('poster-in');
      });
      posterCount.textContent = `${i + 1} из ${n}`;
      // следующий кадр — заранее, чтобы смена была мгновенной
      new Image().src = posterUrl(deck, (i + 1) % n, siteLook());
    };

    function setActive(i: number): void {
      if (i === index && tabs[i].getAttribute('aria-selected') === 'true') return;
      index = i;
      tabs.forEach((t, k) => t.setAttribute('aria-selected', String(k === i)));
      tabs[i].scrollIntoView({ block: 'nearest', inline: 'nearest' });
      if (!frame) showPoster(i);
      schedule();
    }

    function goto(i: number): void {
      expected = i;
      if (frame) send(frame.contentWindow, deck, { type: 'goto', index: i });
      setActive(i);
    }

    function stopAutoplay(): void {
      autoplay = false;
      clearTimeout(timer);
      showcase.removeAttribute('data-autoplay');
    }

    function schedule(): void {
      clearTimeout(timer);
      if (!autoplay) return;
      // перезапуск полоски прогресса на активной вкладке
      showcase.removeAttribute('data-autoplay');
      void showcase.offsetWidth;
      showcase.setAttribute('data-autoplay', '');
      timer = window.setTimeout(tick, SLIDE_MS);
    }

    function tick(): void {
      if (!autoplay) return;
      if (hovered || !visible || document.hidden) {
        timer = window.setTimeout(tick, 600);
        return;
      }
      goto((index + 1) % n);
    }

    function goLive(): void {
      if (frame) return;
      startBtn.disabled = true;
      showcase.querySelector('[data-live-label]')!.textContent = 'Загрузка…';
      expected = index;
      frame = createDeckFrame(deck, index, `Живая презентация: ${showcase.dataset.title}`, () => {
        poster.remove();
        posterBar.remove();
      });
      stage.append(frame);
    }

    const syncPaused = () => showcase.toggleAttribute('data-paused', hovered || !visible);

    startBtn.addEventListener('click', goLive);
    poster.addEventListener('click', goLive);
    tabs.forEach((t, i) => t.addEventListener('click', () => { stopAutoplay(); goto(i); }));
    showcase.addEventListener('pointerenter', () => { hovered = true; syncPaused(); });
    showcase.addEventListener('pointerleave', () => { hovered = false; syncPaused(); });
    // Клик внутри презентации переводит фокус во фрейм — пользователь листает сам
    addEventListener('blur', () => { if (frame && document.activeElement === frame) stopAutoplay(); });

    new IntersectionObserver(([e]) => { visible = e.isIntersecting; syncPaused(); }, { threshold: 0.35 }).observe(showcase);

    addEventListener('message', (e) => {
      if (!frame || e.source !== frame.contentWindow) return;
      const msg = readEnvelope(e.data, deck);
      if (msg?.type !== 'state') return;
      if (msg.index !== expected) {
        // листают внутри презентации: вкладки следуют, автопрокрутка не мешает
        expected = msg.index;
        stopAutoplay();
      }
      setActive(msg.index);
    });

    schedule();
  });
</script>
